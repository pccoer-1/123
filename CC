🔹 Step 3: Write Proper Working Code
Delete default code and paste this:

public class AccountManager {
    
    // Create Account
    public static Account createAccount(String accName) {
        Account acc = new Account(Name = accName);
        insert acc;
        System.debug('Created: ' + acc.Id);
        return acc;
    }
    
    // Get all Accounts
    public static List<Account> getAccounts() {
        return [SELECT Id, Name FROM Account];
    }
    
    // Update Account
    public static void updateAccount(Id accId, String newName) {
        Account acc = [SELECT Id, Name FROM Account WHERE Id = :accId LIMIT 1];
        acc.Name = newName;
        update acc;
        System.debug('Updated: ' + acc.Id);
    }
    
    // Delete Account
    public static void deleteAccount(Id accId) {
        Account acc = [SELECT Id FROM Account WHERE Id = :accId LIMIT 1];
        delete acc;
        System.debug('Deleted: ' + acc.Id);
    }
}
👉 Click Save (Ctrl + S)

